---
import BaseLayout from './BaseLayout.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Tag from '../components/Tag.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DetectiveStamp from '../components/DetectiveStamp.astro';
import { resolvePath } from '../utils/paths.js';
import { formatDate, getReadingTime } from '../utils/blog.js';

const { post, prevPost, nextPost, headings = [] } = Astro.props;
const { data, body } = post;
const {
  title,
  description,
  pubDate,
  updatedDate,
  category,
  tags = [],
  caseNumber = 'MISSION #001',
  coverImage,
} = data;

const readingTime = getReadingTime(body);
const formattedPubDate = formatDate(pubDate);
const formattedUpdatedDate = updatedDate ? formatDate(updatedDate) : null;
const articlesUrl = resolvePath('articles');
---

<BaseLayout
  title={`${title} (${caseNumber})`}
  description={description}
  articleDate={pubDate.toISOString()}
>
  <!-- Back navigation breadcrumb -->
  <div class="mb-6 flex items-center justify-between text-xs font-mono text-sumi-muted dark:text-nightText-muted">
    <a
      href={articlesUrl}
      class="inline-flex items-center gap-1.5 hover:text-hanko dark:hover:text-hanko-light transition-colors"
    >
      <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
      </svg>
      <span>Return to Mission Archive</span>
    </a>

    <div class="flex items-center gap-2">
      <span class="hidden sm:inline">ORBIT TELEMETRY // UNRESTRICTED</span>
      <DetectiveStamp text="FLIGHT LOG" size="sm" />
    </div>
  </div>

  <article class="w-full">
    <!-- Header Mission Dossier -->
    <header class="p-6 sm:p-8 rounded-2xl border border-paper-border dark:border-night-border bg-paper-elevated dark:bg-night-surface shadow-xs mb-10 relative overflow-hidden">
      <!-- Top decorative strip -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-hanko via-aizome to-detective-teal"></div>

      <!-- Mission Number & Category -->
      <div class="flex items-center justify-between gap-3 flex-wrap mb-4">
        <div class="flex items-center gap-2.5">
          <span class="px-2 py-0.5 rounded text-xs font-mono font-bold tracking-wider text-hanko dark:text-hanko-light bg-hanko/10 dark:bg-hanko-light/10 border border-hanko/30 dark:border-hanko-light/30">
            {caseNumber}
          </span>
          <CategoryBadge category={category} size="sm" />
        </div>

        <div class="flex items-center gap-2 text-xs font-mono text-sumi-muted dark:text-nightText-muted">
          <span>{readingTime}</span>
        </div>
      </div>

      <!-- Main Title -->
      <h1 class="text-2xl sm:text-4xl font-extrabold text-sumi dark:text-nightText tracking-tight leading-tight mb-4">
        {title}
      </h1>

      <!-- Mission Summary -->
      <p class="text-base sm:text-lg text-sumi-soft dark:text-nightText-soft leading-relaxed mb-6 font-serif">
        {description}
      </p>

      <!-- Date & Meta Information -->
      <div class="flex items-center justify-between gap-4 pt-4 border-t border-paper-border/60 dark:border-night-border/60 flex-wrap text-xs font-mono text-sumi-muted dark:text-nightText-muted">
        <div class="flex items-center gap-3 flex-wrap">
          <div>
            <span class="text-sumi-faint dark:text-nightText-faint uppercase mr-1">Launched:</span>
            <time datetime={pubDate.toISOString()}>{formattedPubDate}</time>
          </div>

          {formattedUpdatedDate && (
            <div>
              <span class="text-sumi-faint dark:text-nightText-faint uppercase mr-1">Updated:</span>
              <time datetime={updatedDate.toISOString()}>{formattedUpdatedDate}</time>
            </div>
          )}
        </div>

        <div class="flex items-center gap-1.5 flex-wrap">
          {tags.map((tag) => (
            <Tag name={tag} />
          ))}
        </div>
      </div>
    </header>

    <!-- Optional Cover Image -->
    {coverImage && (
      <div class="mb-10 rounded-xl overflow-hidden border border-paper-border dark:border-night-border">
        <img src={coverImage} alt={title} class="w-full h-auto object-cover max-h-[420px]" />
      </div>
    )}

    <!-- Content Layout with Table of Contents Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10">
      <!-- Main Prose Reading Column -->
      <div class="lg:col-span-8 xl:col-span-8 min-w-0">
        <!-- Mobile Table of Contents (collapsible) -->
        {headings.length > 2 && (
          <div class="lg:hidden mb-8">
            <details class="p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-elevated dark:bg-night-surface text-xs font-mono group">
              <summary class="font-bold cursor-pointer text-sumi dark:text-nightText flex items-center justify-between select-none">
                <span class="flex items-center gap-2">
                  <span class="text-hanko dark:text-hanko-light">§</span>
                  <span>TABLE OF CONTENTS // FLIGHT PLAN</span>
                </span>
                <span class="text-sumi-muted dark:text-nightText-muted group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="mt-4 pt-3 border-t border-paper-border dark:border-night-border">
                <TableOfContents headings={headings} />
              </div>
            </details>
          </div>
        )}

        <!-- MDX Article Body -->
        <div class="prose prose-stone dark:prose-invert text-sumi dark:text-nightText max-w-none text-base leading-relaxed break-words">
          <slot />
        </div>

        <!-- Mission Accomplished Footer Seal & Tags -->
        <div class="mt-14 pt-8 border-t border-dashed border-paper-border dark:border-night-border">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-5 rounded-xl bg-paper-muted/60 dark:bg-night-surface border border-paper-border dark:border-night-border">
            <div class="flex items-center gap-3">
              <DetectiveStamp text="MISSION COMPLETE" size="md" variant="hanko" />
              <div>
                <p class="text-xs font-mono font-semibold text-sumi dark:text-nightText">Flight telemetry recorded & stabilized.</p>
                <p class="text-[11px] font-mono text-sumi-muted dark:text-nightText-muted">Simulate and verify in your local runtime environment.</p>
              </div>
            </div>

            <button
              type="button"
              onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
              class="inline-flex items-center justify-center gap-1 text-xs font-mono px-3 py-1.5 rounded-md border border-paper-border dark:border-night-border bg-paper-elevated dark:bg-night-card text-sumi-soft dark:text-nightText-soft hover:text-hanko dark:hover:text-hanko-light transition-colors"
            >
              <svg class="w-3.5 h-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18" />
              </svg>
              <span>Return to Top</span>
            </button>
          </div>
        </div>

        <!-- Article Pagination (Previous / Next Mission) -->
        {(prevPost || nextPost) && (
          <nav class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4 font-mono text-xs" aria-label="Previous and Next Missions">
            {prevPost ? (
              <a
                href={resolvePath(`articles/${prevPost.slug}`)}
                class="group p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-elevated dark:bg-night-surface hover:border-hanko/40 dark:hover:border-hanko-light/40 transition-colors flex flex-col justify-between"
              >
                <div class="flex items-center gap-1 text-sumi-muted dark:text-nightText-muted mb-1">
                  <svg class="w-3.5 h-3.5 group-hover:-translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                  </svg>
                  <span>PREVIOUS MISSION</span>
                </div>
                <div class="font-bold text-sumi dark:text-nightText text-sm group-hover:text-hanko dark:group-hover:text-hanko-light transition-colors line-clamp-2">
                  {prevPost.data.title}
                </div>
              </a>
            ) : (
              <div></div>
            )}

            {nextPost && (
              <a
                href={resolvePath(`articles/${nextPost.slug}`)}
                class="group p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-elevated dark:bg-night-surface hover:border-hanko/40 dark:hover:border-hanko-light/40 transition-colors flex flex-col justify-between text-right"
              >
                <div class="flex items-center justify-end gap-1 text-sumi-muted dark:text-nightText-muted mb-1">
                  <span>NEXT MISSION</span>
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
                <div class="font-bold text-sumi dark:text-nightText text-sm group-hover:text-hanko dark:group-hover:text-hanko-light transition-colors line-clamp-2">
                  {nextPost.data.title}
                </div>
              </a>
            )}
          </nav>
        )}
      </div>

      <!-- Right Column: Desktop Table of Contents -->
      <aside class="hidden lg:block lg:col-span-4 xl:col-span-4">
        <div class="sticky top-24 space-y-6">
          <TableOfContents headings={headings} />

          <!-- Space Mission Specs Widget -->
          <div class="p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-elevated/50 dark:bg-night-surface/50 text-xs font-mono text-sumi-muted dark:text-nightText-muted space-y-2">
            <div class="text-sumi dark:text-nightText font-semibold flex items-center justify-between pb-1 border-b border-paper-border dark:border-night-border">
              <span>MISSION METRICS</span>
              <span class="text-[10px] text-hanko dark:text-hanko-light">{caseNumber}</span>
            </div>
            <div class="flex justify-between py-0.5">
              <span>Sector</span>
              <span class="text-sumi dark:text-nightText font-medium">{category}</span>
            </div>
            <div class="flex justify-between py-0.5">
              <span>Duration</span>
              <span class="text-sumi dark:text-nightText font-medium">{readingTime}</span>
            </div>
            <div class="flex justify-between py-0.5">
              <span>Orbit Status</span>
              <span class="text-detective-teal font-medium">Stabilized</span>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>
