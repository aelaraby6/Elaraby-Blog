---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DetectiveStamp from '../../components/DetectiveStamp.astro';
import { getPublishedPosts, getAllCategories, getAllTags } from '../../utils/blog.js';

const posts = await getPublishedPosts();
const categories = getAllCategories(posts);
const tags = getAllTags(posts);
---

<BaseLayout
  title="Flight Archive // All Mission Logs"
  description="Comprehensive archive of all technical articles, engineering flight logs, and AI architecture notes."
>
  <!-- Page Header -->
  <div class="mb-8 pb-6 border-b border-paper-border dark:border-night-border">
    <div class="flex items-center gap-2 mb-2">
      <DetectiveStamp text="FLIGHT CATALOG" size="sm" />
      <span class="text-xs font-mono text-sumi-muted dark:text-nightText-muted">COMPLETE ARCHIVE</span>
    </div>
    <h1 class="text-2xl sm:text-3xl font-extrabold text-sumi dark:text-nightText tracking-tight mb-2">
      Mission Archive & Flight Logs
    </h1>
    <p class="text-sm text-sumi-soft dark:text-nightText-soft font-serif max-w-xl">
      All technical expeditions, architectural blueprints, and engineering notes recorded in chronological order.
    </p>
  </div>

  <!-- Client-side Interactive Filter Bar (Progressive Enhancement) -->
  <div class="mb-8 p-4 rounded-xl border border-paper-border dark:border-night-border bg-paper-elevated dark:bg-night-surface shadow-xs space-y-4">
    <!-- Search Bar -->
    <div class="relative">
      <svg
        class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-sumi-muted dark:text-nightText-muted"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
      >
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        id="articles-search-input"
        type="text"
        placeholder="Filter logs by title, keywords, or summary..."
        class="w-full pl-10 pr-4 py-2 text-xs sm:text-sm font-mono rounded-lg border border-paper-border dark:border-night-border bg-paper dark:bg-night text-sumi dark:text-nightText focus:outline-none focus:ring-2 focus:ring-hanko/30 placeholder-sumi-muted dark:placeholder-nightText-muted"
        autocomplete="off"
      />
    </div>

    <!-- Category & Tag Filters -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-mono">
      <!-- Category Filter Pills -->
      <div class="flex items-center gap-1.5 flex-wrap">
        <span class="text-sumi-muted dark:text-nightText-muted mr-1">Sector:</span>
        <button
          type="button"
          class="cat-filter-btn px-2.5 py-1 rounded text-xs transition-colors bg-hanko text-white dark:bg-hanko-light dark:text-night font-semibold"
          data-category="ALL"
        >
          All
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="cat-filter-btn px-2.5 py-1 rounded text-xs transition-colors bg-paper-muted dark:bg-night-card text-sumi-soft dark:text-nightText-soft border border-paper-border dark:border-night-border hover:text-hanko dark:hover:text-hanko-light"
            data-category={cat.name}
          >
            {cat.name} ({cat.count})
          </button>
        ))}
      </div>

      <!-- Tag Filter Dropdown or Quick Reset -->
      <div class="flex items-center justify-between sm:justify-end gap-2">
        <span id="filtered-count" class="text-xs text-sumi-muted dark:text-nightText-muted">
          Showing {posts.length} of {posts.length} missions
        </span>
        <button
          id="clear-filter-btn"
          type="button"
          class="hidden px-2 py-0.5 rounded text-[11px] text-hanko dark:text-hanko-light hover:underline font-mono"
        >
          Reset Filter
        </button>
      </div>
    </div>
  </div>

  <!-- Articles List Container -->
  <div id="articles-container" class="space-y-4">
    {posts.map((post) => {
      const { title, description, category, tags = [] } = post.data;
      const searchData = `${title} ${description} ${category} ${tags.join(' ')}`.toLowerCase();
      return (
        <div
          class="article-item"
          data-title={title.toLowerCase()}
          data-category={category}
          data-tags={tags.join(',').toLowerCase()}
          data-search={searchData}
        >
          <ArticleCard post={post} />
        </div>
      );
    })}
  </div>

  <!-- Empty Search Results Placeholder -->
  <div id="no-articles-found" class="hidden py-16 text-center rounded-xl border border-dashed border-paper-border dark:border-night-border bg-paper-elevated/50 dark:bg-night-surface/50">
    <DetectiveStamp text="SIGNAL LOST" size="md" variant="classified" className="mb-3" />
    <p class="font-mono text-sm font-semibold text-sumi dark:text-nightText mb-1">No matching flight logs found.</p>
    <p class="text-xs text-sumi-muted dark:text-nightText-muted font-mono">Try adjusting your search query or sector filters.</p>
  </div>
</BaseLayout>

<script>
  function setupArticleFiltering() {
    const input = document.getElementById('articles-search-input');
    const items = document.querySelectorAll('.article-item');
    const catBtns = document.querySelectorAll('.cat-filter-btn');
    const countDisplay = document.getElementById('filtered-count');
    const emptyNotice = document.getElementById('no-articles-found');
    const resetBtn = document.getElementById('clear-filter-btn');

    let activeCategory = 'ALL';
    let searchQuery = '';

    function filterArticles() {
      let visibleCount = 0;
      const totalCount = items.length;

      items.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        const itemSearchData = item.getAttribute('data-search') || '';

        const matchesCategory = activeCategory === 'ALL' || itemCategory === activeCategory;
        const matchesSearch = !searchQuery || itemSearchData.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      // Update count & empty state
      if (countDisplay) {
        countDisplay.textContent = `Showing ${visibleCount} of ${totalCount} missions`;
      }

      if (emptyNotice) {
        if (visibleCount === 0) {
          emptyNotice.classList.remove('hidden');
        } else {
          emptyNotice.classList.add('hidden');
        }
      }

      if (resetBtn) {
        if (activeCategory !== 'ALL' || searchQuery !== '') {
          resetBtn.classList.remove('hidden');
        } else {
          resetBtn.classList.add('hidden');
        }
      }
    }

    if (input) {
      input.addEventListener('input', (e) => {
        searchQuery = e.target.value.toLowerCase().trim();
        filterArticles();
      });
    }

    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        catBtns.forEach((b) => {
          b.classList.remove('bg-hanko', 'text-white', 'dark:bg-hanko-light', 'dark:text-night', 'font-semibold');
          b.classList.add('bg-paper-muted', 'dark:bg-night-card', 'text-sumi-soft', 'dark:text-nightText-soft');
        });
        btn.classList.remove('bg-paper-muted', 'dark:bg-night-card', 'text-sumi-soft', 'dark:text-nightText-soft');
        btn.classList.add('bg-hanko', 'text-white', 'dark:bg-hanko-light', 'dark:text-night', 'font-semibold');

        activeCategory = btn.getAttribute('data-category') || 'ALL';
        filterArticles();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeCategory = 'ALL';
        searchQuery = '';
        if (input) input.value = '';
        catBtns.forEach((b) => {
          if (b.getAttribute('data-category') === 'ALL') {
            b.classList.add('bg-hanko', 'text-white', 'dark:bg-hanko-light', 'dark:text-night', 'font-semibold');
            b.classList.remove('bg-paper-muted', 'dark:bg-night-card', 'text-sumi-soft', 'dark:text-nightText-soft');
          } else {
            b.classList.remove('bg-hanko', 'text-white', 'dark:bg-hanko-light', 'dark:text-night', 'font-semibold');
            b.classList.add('bg-paper-muted', 'dark:bg-night-card', 'text-sumi-soft', 'dark:text-nightText-soft');
          }
        });
        filterArticles();
      });
    }
  }

  setupArticleFiltering();
  document.addEventListener('astro:after-swap', setupArticleFiltering);
</script>
