---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import DetectiveStamp from '../../components/DetectiveStamp.astro';
import { getPublishedPosts, getAllCategories, slugify } from '../../utils/blog.js';
import { resolvePath } from '../../utils/paths.js';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const categories = getAllCategories(posts);

  return categories.map((category) => {
    const categoryPosts = posts.filter(
      (post) => slugify(post.data.category) === category.slug
    );

    return {
      params: { category: category.slug },
      props: { category, posts: categoryPosts },
    };
  });
}

const { category, posts } = Astro.props;
const categoriesUrl = resolvePath('categories');
---

<BaseLayout
  title={`Category: ${category.name}`}
  description={`All technical case notes and articles filed under the ${category.name} category.`}
>
  <div class="mb-8 pb-6 border-b border-paper-border dark:border-night-border">
    <div class="mb-4">
      <a
        href={categoriesUrl}
        class="inline-flex items-center gap-1 text-xs font-mono text-sumi-muted dark:text-nightText-muted hover:text-hanko dark:hover:text-hanko-light transition-colors"
      >
        ← Return to all categories
      </a>
    </div>

    <div class="flex items-center gap-2 mb-2">
      <DetectiveStamp text="CATEGORY ARCHIVE" subtext={category.name} size="sm" />
      <span class="text-xs font-mono text-sumi-muted dark:text-nightText-muted">{posts.length} {posts.length === 1 ? 'case file' : 'case files'}</span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-extrabold text-sumi dark:text-nightText tracking-tight mb-2">
      Category: {category.name}
    </h1>

    <p class="text-sm text-sumi-soft dark:text-nightText-soft font-serif max-w-xl">
      {category.description}
    </p>
  </div>

  <div class="space-y-4">
    {posts.map((post) => (
      <ArticleCard post={post} />
    ))}
  </div>
</BaseLayout>
